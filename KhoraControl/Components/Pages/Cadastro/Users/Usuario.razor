@page "/Usuarios"
@using KhoraControl.Domain.Models.Entities
@using KhoraControl.Infrastructure.Services

@inject UserService Service
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudPaper Elevation="1">
    <MudToolBar Dense="true" Gutters="true">
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
            <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="(() => DialogAsync())">Novo Usuário</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Update"/>
        </MudButtonGroup>
    </MudToolBar>
</MudPaper>
<br><br>

<MudText Typo="Typo.h5" Align="Align.Center">Usuários</MudText>
<MudDataGrid Items="@_usersFiltered" T="UserAccount" Hover="true" Bordered="true" Striped="true" Dense="true"
             SortMode="SortMode.Multiple" Filterable="true" Virtualize="true" Loading="_isLoading">
    <Columns>
        <PropertyColumn Property="x => x.UserName" Title="Nome" Sortable="true" Filterable="true"/>
        <TemplateColumn Hidden="false" CellClass="d-flex justify-center">
            <CellTemplate>
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" OnClick="@(() => DialogAsync(@context.Item, true))" />
                <MudSpacer />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" OnClick="@(() => Delete(@context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="UserAccount" />
    </PagerContent>
</MudDataGrid>

@code {
    private string _searchString = "";
    private bool _isLoading = false;
    private IEnumerable<UserAccount> _users = new List<UserAccount>();

    private IEnumerable<UserAccount> _usersFiltered
    {
        get
        {
            var usersFiltered = _users;

            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                usersFiltered = usersFiltered.Where(x =>
                    x.UserName.Contains(_searchString, StringComparison.OrdinalIgnoreCase));
            }

            return usersFiltered;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            _users = await Service.GetAllUsersAsync();

        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DialogAsync(UserAccount? user = null, bool update = false)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        IDialogReference dialog;
        if (update && user != null)
        {
            var parametros = new DialogParameters<CadastrarUsuario>
            {
                { x => x.user, user }
            };

            dialog = await DialogService.ShowAsync<CadastrarUsuario>("Cadastro de Usuários", parametros, options);
        }
        else
        {
            dialog = await DialogService.ShowAsync<CadastrarUsuario>("Cadastro de Usuários", options);
        }
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task Delete(UserAccount user)
    {
        var parametros = new DialogParameters<DialogUsuario>
        {
            { x => x.ContentText, "Tem certeza que você quer deletar este registro?, este processo não pode ser revertido!" },
            { x => x.ButtonText, "Deletar" },
            { x => x.Color, Color.Error },
            { x => x.User, user }
        };

        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = await DialogService.ShowAsync<DialogUsuario>("Deletar", parametros, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
        }
    }
}