@page "/Produto"
@using KhoraControl.Infrastructure.Services

@inject ProdutoService ProdutoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudPaper Elevation="1">
    <MudToolBar>
        <MudButton StartIcon="@Icons.Material.Outlined.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => DialogAsync())">Novo</MudButton>
        <MudIconButton OnClick="@(() => LoadData())" Icon="@Icons.Material.Outlined.Update" Variant="Variant.Filled" Color="Color.Primary"/>
        <MudSpacer/>
        <MudTextField T="string" Label="Buscar Produto" 
                      HelperText="Digite o nome de um produto para buscar" 
                      @bind-Value="_searchString" 
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"/>
    </MudToolBar>
</MudPaper>
<br><br>
<MudDataGrid Items="@_produtosFiltrados" T="Domain.Models.Produto" Hover="true" Bordered="true" Striped="true" Dense="true"
             SortMode="SortMode.Multiple" Filterable="true" Virtualize="true" Loading="_isLoading">
    <Columns>
        <PropertyColumn Property="x => x.CodigoInterno" Title="Código Interno" Sortable="true" Filterable="true"/>
        <PropertyColumn Property="x => x.DataValidade" Title="Validade" Sortable="true" Filterable="true" Format="dd/MM/yyyy"/>
        <PropertyColumn Property="x => x.Descricao" Title="Descrição" Sortable="true" Filterable="true"/>
        <PropertyColumn Property="x => x.Status" Title="Status" Sortable="true" Filterable="true"/>
        <PropertyColumn Property="x => x.Fornecedor" Title="Fornecedor" Sortable="true" Filterable="true"/>
        <PropertyColumn Property="x => x.Quantidade" Title="Quantidade" Sortable="true" Filterable="true"/>
    <TemplateColumn Hidden="false" CellClass="d-flex justify-center">
        <CellTemplate>
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditDialogAsync(@context.Item))"/>
            <MudSpacer/>
            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" OnClick="@(() => Delete(@context.Item))"/>
        </CellTemplate>
    </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Domain.Models.Produto" />
    </PagerContent>
</MudDataGrid>

@code {
    private string _searchString = "";
    private IEnumerable<Domain.Models.Produto> _produtos = new List<Domain.Models.Produto>();
    private bool _isLoading = false;

    private IEnumerable<Domain.Models.Produto> _produtosFiltrados =>
        string.IsNullOrWhiteSpace(_searchString)
            ? _produtos
            : _produtos.Where(x =>
                x.Descricao.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                x.Fornecedor.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                x.CodigoInterno.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
                );

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            _produtos = await ProdutoService.GetAllAsync();

        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    private async Task Delete(Domain.Models.Produto produto)
    {
        var parametros = new DialogParameters<DialogProduto>
        {
            { x => x.ContentText, "Tem certeza que você quer deletar este registro?, este processo não pode ser revertido!" },
            { x => x.ButtonText, "Deletar" },
            { x => x.Color, Color.Error },
            { x => x.Produto, produto }
        };

        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = await DialogService.ShowAsync<DialogProduto>("Deletar", parametros, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
        }
    }
    
    private async Task OpenEditDialogAsync(Domain.Models.Produto produto)
    {
        var parametros = new DialogParameters<CadastrarProduto>
        {
            { x => x.produto, produto }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true};
        var dialog = await DialogService.ShowAsync<CadastrarProduto>("Cadastro de Veículo", parametros, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
        }
    }
    
    private async Task DialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true};
        var dialog = await DialogService.ShowAsync<CadastrarProduto>("Cadastro de Produtos", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
        }
    }

}